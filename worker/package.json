{
  "name": "bms-wip-charts-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ./wrangler.toml",
    "deploy": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/deploy-worker.ps1 -Deploy",
    "deploy:check": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/deploy-worker.ps1",
    "typecheck": "tsc --noEmit",
    "test:security": "node scripts/test-security-rate-limits.mjs && node scripts/test-multipart-upload.mjs && node scripts/test-zip-dependency-compat.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.3"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.24.0"
  }
}
